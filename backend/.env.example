APP_ENV=development
APP_NAME="SmartDine AI"
APP_TIMEZONE=Asia/Karachi
CURRENCY=PKR
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smartdine
JWT_SECRET_KEY=
GROQ_API_KEY=
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
JOB_POLL_SECONDS=2
JOB_LEASE_SECONDS=120
